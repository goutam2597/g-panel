{
  "name": "g-panel",
  "version": "1.0.0",
  "description": "G-Panel — self-hosted cPanel-style web hosting control panel",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "npm run build --workspace web",
    "test": "node --test server/test/",
    "dev": "node server/src/index.js"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "ssh2@1.17.0": true
  }
}
